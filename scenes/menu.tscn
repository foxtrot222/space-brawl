theme_override_fonts/font = ExtResource("1_yqeox")
theme_override_font_sizes/font_size = 16
text = "Actions:
FT:Forward Thrust
RT:Reverse Thrust
LR:Left Rotate
RR:Right Rotate
QJ:Quantum Jump
F:Fire
B:Select Bullet
M:Select Missile
L:Select Laser

Keyboard Controls:
FT : W, I, Kp(5)
LR : A, J, Kp(1)
RT : S, K, Kp(2)
RR : D, L, Kp(3)
QJ : Q, U, Kp(4)
F  : E, O, Kp(6)
B  : 1, 7, Kp(7)
M  : 2, 8, Kp(8)
L  : 3, 9, Kp(9)

Gamepad Controls:
FT : RT
RT : LT
LR : L-Stick Left / R-Stick Left
RR : L-Stick Right / R-Stick Right
QJ : Y / Triangle, D-pad Up
F  : X / Square
B  : A / Cross, D-pad Left
M  : D-pad Down
L  : B / Circle, D-pad Right

Other Controls:
ENTER/START to play or go to menu
Esc/SELECT to pause and view stats"
autowrap_mode = 2

